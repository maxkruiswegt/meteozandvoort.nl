# Supply-chain hardening. Needs npm >= 11.10 (enforced via devEngines in package.json).

# Never run dependency install scripts (only fsevents has one, macOS-only and optional).
ignore-scripts=true

# Ignore versions published in the last 7 days; hijacked releases are usually pulled within hours.
min-release-age=7

# No git-hosted packages anywhere in the tree.
allow-git=none
